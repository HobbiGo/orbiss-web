{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbiss-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "orbiss-db", "database_id": "e6fa959e-275b-4ad3-a086-55fe23442086" }],
  "ratelimits": [{ "name": "AUTH_RATE_LIMITER", "namespace_id": "827461933", "simple": { "limit": 5, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "TALK_ROOMS", "class_name": "OrbissTalkRoom" }] },
  "migrations": [{ "tag": "orbiss-talk-v1", "new_sqlite_classes": ["OrbissTalkRoom"] }]
}
