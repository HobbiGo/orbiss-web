{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbiss-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbiss-db",
      "database_id": "e6fa959e-275b-4ad3-a086-55fe23442086"
    }
  ]
}
